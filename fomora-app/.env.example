# Supabase — get these from your Supabase project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only — same page, "service_role" key. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Random long string. Used to authenticate Vercel cron calls.
CRON_SECRET=replace-with-a-long-random-string

# Public site URL — http://localhost:3000 in dev, https://your.vercel.app in prod
NEXT_PUBLIC_SITE_URL=http://localhost:3000
